{
  "name": "resume-builder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "test:phase1": "node server/tests/workspace.test.ts",
    "test:phase2a": "node server/tests/events.test.ts",
    "test:phase2b": "node server/tests/attention.test.ts",
    "test:phase3": "node server/tests/preparation.test.ts",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "node server/src/index.ts",
    "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
